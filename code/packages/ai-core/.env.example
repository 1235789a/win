# ─────────────────────────────────────────────────────────────
#  @mi/ai-core 默认客户端读的环境变量
#  把需要的复制到你项目的 .env.local
# ─────────────────────────────────────────────────────────────

# 选 provider：openai（含 Gemini OpenAI-compat / DeepSeek 等）或 anthropic
AI_PROVIDER=openai

# ---- OpenAI 家族（Gemini 也走这里） ----
OPENAI_API_KEY=AIza-your-gemini-key-or-sk-openai-key
# Gemini 免费额度最大的端点：
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 推荐（free tier 最稳）：
OPENAI_MODEL=gemini-2.5-flash-lite
# 备选：gemini-2.5-flash / gemini-2.0-flash / gpt-4o-mini / gpt-4.1-mini

# ---- Anthropic Claude（留空就不用） ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- 大陆访问 Google/Anthropic API 的代理（Clash 默认 7890） ----
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
